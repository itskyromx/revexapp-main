{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revexapp-main",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Add nodejs_compat compatibility flag to support common database drivers
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
